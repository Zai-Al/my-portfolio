# Base URL of your ASP.NET Core API (Render URL in production)
NEXT_PUBLIC_API_URL=http://localhost:5080

# Supabase project (used by the admin login only - Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Turnstile site key (public) for the "Show email" spam check. Unset = no email card.
# Local dev can use Cloudflare's always-pass test key: 1x00000000000000000000AA
# (pair it with the test secret 1x0000000000000000000000000000000AA in the API's Turnstile:SecretKey).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
